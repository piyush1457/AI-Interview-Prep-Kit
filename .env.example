# Groq LLM — required
GROQ_API_KEY=
# Brave Search — optional, falls back to honest empty NO_DISCUSSION
BRAVE_API_KEY=
# Mongo
MONGODB_URI=mongodb://localhost:27017/ai-prep-kit
# or Atlas: mongodb+srv://user:pass@cluster.mongodb.net/ai-prep-kit?retryWrites=true&w=majority
# Session
SESSION_SECRET=change-me-32-chars-min
# Backend URL (Render) and frontend proxy target
API_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE=http://localhost:4000
# Batch local-host allowance — true only for evaluate against localhost:8099 fixtures
ALLOW_LOCALHOST=false
# Optional: tune Groq gap if 429 persists
GROQ_DELAY_MS=500
# Port
PORT=4000
