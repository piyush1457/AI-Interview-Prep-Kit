# Groq LLM - required
GROQ_API_KEY=
# Optional model override (default openai/gpt-oss-20b)
GROQ_MODEL=
# Public discussion search chain: Brave (if key) -> Tavily (if key) -> DuckDuckGo HTML (zero key).
# All optional; empty everywhere yields honest NO_DISCUSSION, never fatal.
BRAVE_API_KEY=
TAVILY_API_KEY=
# SEARCH_PROVIDER reserved: auto (default chain above)
# Mongo
MONGODB_URI=mongodb://localhost:27017/ai-prep-kit
# or Atlas: mongodb+srv://user:pass@cluster.mongodb.net/ai-prep-kit?retryWrites=true&w=majority
# Session
SESSION_SECRET=change-me-32-chars-min
# Backend origin allowed by CORS (Render URL in prod) + frontend proxy target
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE=http://localhost:4000
# Batch local-host allowance - true only for evaluate against localhost:8099 fixtures
ALLOW_LOCALHOST=false
# Optional: tune Groq gap if 429 persists
GROQ_DELAY_MS=500
# Port
PORT=4000
